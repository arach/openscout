# OpenScout local environment overrides.
#
# Most credentials live in the macOS keychain via the `secret` CLI; see
# docs/local-secrets.md for the full list. Use this file only for one-off
# local overrides — values here win over keychain values.
#
# To override the npm publish token for one shell session instead of pulling
# from the keychain:
#   NPM_TOKEN=npm_...
# Sensitive-by-default: `varlock init` ships @defaultSensitive=false and tags
# items by name heuristics, which leaked the GH token (a PAT) in plaintext.
# @defaultRequired=infer @defaultSensitive=true
# @generateTsTypes(path=env.d.ts)

# GitHub PAT. Left unmarked by `varlock init` (its name heuristics look for
# TOKEN/KEY/SECRET), which is exactly how it leaked in plaintext — the
# @defaultSensitive=true above is what covers it now.
GH=
# @sensitive
NPM_TOKEN=
# @sensitive
HERMES_API_KEY=
# Scout provider keys. Values are NOT stored here — they resolve from the macOS
# login keychain via the `secret` CLI (docs/local-secrets.md) at load time.
# @sensitive @required=false
SCOUT_OPENCODE_API_KEY=exec(`secret get SCOUT_OPENCODE_API_KEY`)
